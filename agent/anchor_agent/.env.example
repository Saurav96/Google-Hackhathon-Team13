# Copy to agent/anchor_agent/.env (adk web / adk run load it automatically). Do not commit .env.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-qwiklabs-project-id
# Gemini 3.x models are served from the global endpoint, not us-central1.
GOOGLE_CLOUD_LOCATION=global

GEMINI_MODEL=gemini-3.5-flash
BQ_LOCATION=US
BQ_DATASET=a4i_econ
BQ_GRAPH=LocalEconomy

# Managed MCP server. Default: BigQuery's Google-managed endpoint.
# For MCP Toolbox for Databases on Cloud Run, set MCP_URL=https://<toolbox-service>/mcp
MCP_ENABLED=true
MCP_URL=https://bigquery.googleapis.com/mcp
